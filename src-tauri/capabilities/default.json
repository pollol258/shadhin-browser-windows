{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and toolbar",
  "windows": ["*"],
  "webviews": ["*"],
  "remote": {
    "urls": ["http://*/*", "https://*/*"]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:event:default"
  ]
}
